opam-version: "2.0"
version: "2026.10"
synopsis:
  "ALVIE/Core: active automata learning (L#) and model comparison, with no backend"
description:
  "The L# learner and its equivalence oracles, the model file format, and the comparison engine that finds witnesses with mCRL2. A backend (such as alvie-sancus) provides the system under learning."
maintainer: ["Matteo Busi, Riccardo Focardi, Flaminia Luccio"]
authors: ["Matteo Busi, Riccardo Focardi, Flaminia Luccio"]
license: "MIT"
tags: ["automata learning" "formal verification" "alvie"]
homepage: "https://unive-alvie.github.io/alvie/"
bug-reports: "https://github.com/unive-alvie/alvie/issues"
depends: [
  "dune" {>= "3.1"}
  "ocaml" {>= "4.13"}
  "core"
  "core_unix"
  "logs"
  "ocamlgraph"
  "ppx_deriving"
  "ppx_hash"
  "ppx_jane"
  "ppx_sexp_conv"
  "shexp"
  "yaml"
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/unive-alvie/alvie.git"
