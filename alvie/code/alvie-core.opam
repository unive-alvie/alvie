# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "2026.10"
synopsis:
  "ALVIE/Core: learn models of a system with L# and compare them to find information leaks, for any platform with a plugin"
description:
  "The L# learner and its equivalence oracles, the input generator of specs, the comparison engine that finds witnesses with mCRL2, the plugin files, the commands of Core for any plugin, the protocol of external plugins, and Tiny, the reference platform. A plugin (such as alvie-sancus) connects it to a platform."
maintainer: ["Matteo Busi, Riccardo Focardi, Flaminia Luccio"]
authors: ["Matteo Busi, Riccardo Focardi, Flaminia Luccio"]
license: "MIT"
tags: ["automata learning" "formal verification" "alvie"]
homepage: "https://unive-alvie.github.io/alvie/"
bug-reports: "https://github.com/unive-alvie/alvie/issues"
depends: [
  "dune" {>= "3.1"}
  "ocaml" {>= "4.13"}
  "core"
  "core_unix"
  "logs"
  "ocamlgraph"
  "ppx_deriving"
  "ppx_hash"
  "ppx_jane"
  "ppx_sexp_conv"
  "shexp"
  "yaml"
  "yojson"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/unive-alvie/alvie.git"
