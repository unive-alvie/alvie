; The comparison engine: models as LTSs, mCRL2 trace inclusion, witness extraction and witness graphs.
; It is generic in the inputs and outputs; a backend gives its view of them through Hooks.S.
(library
  (name ltscompare)
  (public_name alvie-core.compare)
  (modules hooks obs lts cexfinder)
  (preprocess (pps ppx_jane ppx_deriving.show ppx_deriving.ord ppx_deriving.eq ppx_deriving.make ppx_sexp_conv ppx_hash))
  (libraries learninglib core core_unix core_unix.sys_unix logs ocamlgraph shexp.process)
)

(env
  (dev
    (flags (:standard -warn-error -A))
  )
)
