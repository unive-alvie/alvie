; The Sancus instance of the comparison engine of alvie-core (ltscompare): the inputs and outputs that fa.exe
; compares, and the Sancus hooks (attacker inputs, public equality, hidden outputs, victim code).
(library
  (name ltscomparator)
  (public_name alvie-sancus.compare)
  (modules cexfinder obs)
  (preprocess (pps ppx_jane ppx_deriving.show ppx_deriving.ord ppx_deriving.eq ppx_deriving.make ppx_sexp_conv ppx_hash))
  (libraries ltscompare sancus learninglib core logs ocamlgraph)
)

(env
  (dev
    (flags (:standard -warn-error -A))
  )
)
