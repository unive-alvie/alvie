(include_subdirs unqualified)

; ALVIE/Sancus: its portable part (alvie-sancus.core, included in the module Sancus) and the simulator on Verilator,
; which needs the Unix library.
(library
 (name sancus)
  (public_name alvie-sancus.sancus)
  (modules sancus simulator verilog native)
  (flags (:standard -open Sancus_core))
  (preprocess (pps ppx_deriving.show ppx_deriving.ord ppx_deriving.eq ppx_deriving.make ppx_deriving.fold ppx_sexp_conv ppx_hash ppx_let))
  (libraries sancus_core prof learninglib alvie_plugin alvie_inputgen alvie_backend core logs core_unix.sys_unix core_unix vcd shexp.process str)
)
