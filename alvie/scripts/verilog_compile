#!/bin/bash

if [[ "$OSTYPE" == darwin* ]]; then
    shopt -s expand_aliases
    alias sed='gsed'
fi

tmpdir="$1";

verfile="../src/$2.v";
submitfile="$3";

# Copy necessary files
mkdir -p $tmpdir
cp $verfile $tmpdir/stimulus.v

# Start verilog simulation
echo "Compiling $verfile => $tmpdir/simv"
# iverilog -o $tmpdir/simv -I $tmpdir -c $submitfile

# Only the top level of the testbench is traced (it includes copies of the internal signals
# ALVIE needs, see generic.v): set ALVIE_FULL_TRACE=1 to dump every signal instead.
if [ "$ALVIE_FULL_TRACE" == "1" ]; then
    trace_depth=""
else
    trace_depth="--trace-depth 1"
fi

verilator -O3 --noassert -I$tmpdir -f $submitfile --binary -j 0 -Wno-fatal --trace $trace_depth --Mdir $tmpdir/sancus-core-gap/obj_dir -o simv
