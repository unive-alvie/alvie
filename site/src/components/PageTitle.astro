---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { Badge } from '@astrojs/starlight/components';

// The sidebar shows the short badge text (B or A); the page title spells it out.
const names = { B: 'Beginner', A: 'Advanced' };
const badge = Astro.locals.starlightRoute.entry.data.sidebar.badge;
---

<Default {...Astro.props}><slot /></Default>
{badge && (
  <p class="level-badge">
    <Badge text={names[badge.text] ?? badge.text} variant={badge.variant} size="medium" />
  </p>
)}

<style>
  .level-badge {
    margin-top: 0.5rem;
  }
</style>
