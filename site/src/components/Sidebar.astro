---
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { Badge } from '@astrojs/starlight/components';
---

<Default {...Astro.props}><slot /></Default>
<aside class="level-legend" aria-label="Reading levels">
  <p><Badge text="A" variant="caution" /> - Advanced: assumes some ALVIE knowledge</p>
</aside>

<style>
  /* The sidebar container adds a 1rem gap above this note; pull it back toward the entries. */
  .level-legend {
    margin-top: -0.5rem;
    padding: 0.5rem 0.5rem 0;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }
  .level-legend p {
    margin: 0;
  }
</style>
